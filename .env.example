# 환경 변수 예시 (ARCHITECTURE §6) — 복사해서 .env로 쓴다: cp .env.example .env
# .env는 Git에 올리지 않는다. 비밀번호·키는 각자 바꾼다.

# MariaDB (docker compose가 컨테이너를 만들 때 사용)
MARIADB_ROOT_PASSWORD=change-me
# 계정 이름은 doingit으로 고정 (docker/mariadb/init.sql이 이 이름에 권한을 준다)
MARIADB_USER=doingit
MARIADB_PASSWORD=change-me

# 백엔드 DB 접속 주소 (비밀번호는 MARIADB_PASSWORD와 같게)
DATABASE_URL=mysql+pymysql://doingit:change-me@localhost:3307/doing_it?charset=utf8mb4
# pytest 전용 DB (테스트마다 테이블을 비우므로 개발 DB와 분리)
TEST_DATABASE_URL=mysql+pymysql://doingit:change-me@localhost:3307/doing_it_test?charset=utf8mb4

# JWT 서명 키 — 32자 이상 무작위 문자열. 비어 있거나 짧으면 백엔드가 시작하지 않는다
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# 토큰 만료(분) — 2시간
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS 허용 주소 (Vite 개발 서버)
FRONTEND_ORIGIN=http://localhost:5173
