          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 목록, 방금 만든 프로젝트가 맨 위\", () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.page).to.eql(1);",
              "  pm.expect(body.size).to.eql(20);",
              "  pm.expect(body.total).to.be.at.least(1);",
              "  pm.expect(body.items[0].id).to.eql(pm.collectionVariables.get(\"projectId\"));",
              "});"
            ]
          }
        }
      ]
