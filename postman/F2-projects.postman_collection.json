{
  "info": {
    "name": "동잇 F2 프로젝트",
    "description": "F2 프로젝트 API 확인 (PRJ-01·02·03·07, API-SPEC §5.2). 위에서부터 순서대로 실행한다.\nOWNER(A)와 멤버가 아닌 사용자(B)를 새로 만들어 403까지 확인한다. 환경: local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "준비 - A 가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "signup"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login_id\": \"{{ownerLoginId}}\",\n  \"password\": \"password123\",\n  \"name\": \"프로젝트주인\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 실행할 때마다 새 아이디를 만든다 (영문 소문자·숫자 4~20자)",
              "pm.collectionVariables.set(\"ownerLoginId\", \"pmo\" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 가입, password_hash 없음\", () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.login_id).to.eql(pm.collectionVariables.get(\"ownerLoginId\"));",
              "  pm.expect(body).to.not.have.property(\"password_hash\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "준비 - A 로그인",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login_id\": \"{{ownerLoginId}}\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 토큰 발급\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().token_type).to.eql(\"bearer\");",
              "});",
              "pm.collectionVariables.set(\"ownerToken\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
