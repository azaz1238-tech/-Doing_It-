    {
      "name": "프로젝트 생성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"포스트맨 확인\",\n  \"description\": \"Postman 컬렉션으로 만든 프로젝트\",\n  \"start_date\": \"2026-11-17\",\n  \"end_date\": \"2026-11-26\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 생성, 만든 사람은 OWNER\", () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.my_role).to.eql(\"OWNER\");",
              "  pm.expect(body.name).to.eql(\"포스트맨 확인\");",
              "  pm.expect(body.created_at).to.match(/Z$/);",
              "});",
              "pm.collectionVariables.set(\"projectId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
